{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChelseaKR/trans-docs-navigator/api/v1/error.schema.json",
  "title": "API error",
  "description": "A machine-readable error. `message` is a fixed string: nothing from the request is ever copied into a response.",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "1"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_jurisdiction",
            "unsupported_language",
            "unknown_endpoint"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "error"
  ],
  "additionalProperties": false
}
