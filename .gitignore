*.log
.DS_Store
coverage/
dist/
.env
.env.*
!.env.example
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/*.tfstate*
# Ephemeral by design: nothing user-generated is ever persisted.
*.session.json
tmp/

# runtime-fetched portfolio-standards (never commit)
.standards/

# G9 pseudolocale — generated from src/i18n/en.ts by scripts/i18n-pseudo.ts, never a shipping locale
tests/e2e/i18n/en-XA.generated.json
# G10 — CSS extracted from src/render.ts STYLE for stylelint (tmp/ is already ignored; explicit for clarity)
tmp/app.generated.css
# Playwright (G9 overflow gate) output
test-results/
playwright-report/
.playwright/

# Lighthouse CI (P1-4) local run output
.lighthouseci/
lighthouseci-reports/

# Corpus integrity manifest (FIX-09 §A) — a build artifact, regenerated by
# `npm run corpus:manifest` / the Dockerfile RUN step, never hand-authored or committed.
corpus.manifest.json

# CodeQL local SARIF output (.github/workflows/codeql.yml) — `codeql-action/analyze` runs with
# `upload: never` on this private repo and writes its SARIF here for scripts/codeql-gate.mjs to
# read. A scan artifact, never committed.
sarif-results/
