# no trailing slash: `node_modules/` matches only a directory, so a symlink named
# node_modules (a dev-worktree shortcut) slipped into a commit via `git add -A`.
node_modules
.claude/
*.log
.DS_Store
coverage/
dist/
.env
.env.*
!.env.example
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/*.tfstate*
# Ephemeral by design: nothing user-generated is ever persisted.
*.session.json
tmp/

# runtime-fetched portfolio-standards (never commit)
.standards/

# G9 pseudolocale — generated from src/i18n/en.ts by scripts/i18n-pseudo.ts, never a shipping locale
tests/e2e/i18n/en-XA.generated.json
# G10 — CSS extracted from src/render.ts STYLE for stylelint (tmp/ is already ignored; explicit for clarity)
tmp/app.generated.css
# Playwright (G9 overflow gate) output
test-results/
playwright-report/
.playwright/

# Lighthouse CI (P1-4) local run output
.lighthouseci/
lighthouseci-reports/

# Corpus integrity manifest (FIX-09 §A) — a build artifact, regenerated by
# `npm run corpus:manifest` / the Dockerfile RUN step, never hand-authored or committed.
corpus.manifest.json

# CodeQL local SARIF output (.github/workflows/codeql.yml) — `codeql-action/analyze` writes its
# SARIF here (via `output:`) for scripts/codeql-gate.mjs to read, as well as uploading it to code
# scanning. A scan artifact, never committed. (This said "`upload: never` on this private repo"
# until 2026-09-06; the repo is public and the upload is back on. See #239.)
sarif-results/

# Verifier workbench (scripts/verify-record.ts) local working state — per-jurisdiction
# progress so a session is resumable, and the reviewer's free-text rejection notes. Local
# to one verifier's machine by design: notes are NOT corpus content and must never reach
# rendered output. See docs/VERIFIER-WORKBENCH.md.
.verifier-workbench/
